{
	"name": "lucian-solutions-v2",
	"private": true,
	"version": "2.0.3",
	"type": "module",
	"engines": {
		"node": "^22.13.0 || ^24.0.0 || >=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "^5.1.1",
		"daisyui": "^5.8.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"font-awesome": "^4.7.0",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.1.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.3.1",
		"@twemoji/api": "^17.0.3",
		"dotenv": "^18.0.10",
		"prismjs": "^1.30.0"
	}
}
